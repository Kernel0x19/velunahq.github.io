---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Download from '../components/Download.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Navbar />
  <Hero />
  <hr class="divider" />
  <Features />
  <hr class="divider" />
  <Download />
  <hr class="divider" />
  <Community />
  <Footer />

  <button id="back-top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="19" x2="12" y2="5"/>
      <polyline points="5 12 12 5 19 12"/>
    </svg>
  </button>

  <script>
    (function() {
      var nav = document.getElementById('nav');
      window.addEventListener('scroll', function() {
        nav.classList.toggle('scrolled', window.scrollY > 20);
      }, { passive: true });

      var bar = document.getElementById('progress-bar');
      window.addEventListener('scroll', function() {
        var h = document.documentElement;
        var pct = (window.scrollY / (h.scrollHeight - h.clientHeight)) * 100;
        bar.style.width = pct + '%';
      }, { passive: true });

      var revealEls = document.querySelectorAll('.reveal');
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach(function(el) { io.observe(el); });

      var sections = ['features', 'download', 'community'];
      var navLinks = {};
      sections.forEach(function(id) {
        var el = document.querySelector('.nav-links a[href="#' + id + '"]');
        if (el) navLinks[id] = el;
      });
      window.addEventListener('scroll', function() {
        var y = window.scrollY + 120;
        var active = null;
        sections.forEach(function(id) {
          var sec = document.getElementById(id);
          if (sec && sec.offsetTop <= y) active = id;
        });
        Object.keys(navLinks).forEach(function(id) {
          navLinks[id].classList.toggle('active', id === active);
        });
      }, { passive: true });

      var mobileNav = document.getElementById('mobile-nav');
      document.getElementById('ham').addEventListener('click', function() {
        var isOpen = mobileNav.classList.toggle('open');
        document.getElementById('mobile-overlay').classList.toggle('open', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      window.closeMobile = function() {
        mobileNav.classList.remove('open');
        document.getElementById('mobile-overlay').classList.remove('open');
        document.body.style.overflow = '';
      };

      var topBtn = document.getElementById('back-top');
      window.addEventListener('scroll', function() {
        topBtn.classList.toggle('show', window.scrollY > 500);
      }, { passive: true });
      topBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      var ua = navigator.userAgent || '';
      var isMac = /Macintosh|MacIntel|MacPPC|Mac68K/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      var isWin = /Win32|Win64|Windows|WinCE/i.test(ua);
      var isLinux = /Linux/i.test(ua) && !/Android/i.test(ua);

      var targetId = isLinux ? 'card-linux' : (isWin ? 'card-windows' : (isMac ? 'card-macos' : null));
      var badgeId = isLinux ? 'badge-linux' : (isWin ? 'badge-windows' : (isMac ? 'badge-macos' : null));

      if (targetId) {
        var card = document.getElementById(targetId);
        if (card) card.classList.add('is-active-os');
        var badge = document.getElementById(badgeId);
        if (badge) badge.style.display = 'inline-block';
      }

      var starEl = document.getElementById('gh-star-count');
      var cachedStars = null;
      try { cachedStars = localStorage.getItem('veluna_gh_stars'); } catch (e) {}
      if (cachedStars && starEl) starEl.textContent = cachedStars;
      fetch('https://api.github.com/repos/velunahq/veluna')
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(repo) {
          if (!repo || typeof repo.stargazers_count !== 'number') return;
          var count = repo.stargazers_count;
          var formatted = count >= 1000 ? (count / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : count.toString();
          if (starEl) starEl.textContent = formatted;
          try { localStorage.setItem('veluna_gh_stars', formatted); } catch (e) {}
        })
        .catch(function() {});

      fetch('https://api.github.com/repos/velunahq/veluna/releases/latest')
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(rel) {
          if (!rel || !rel.assets) return;
          var tag = rel.tag_name || 'v0.1.7';
          var chip = document.getElementById('latest-version-chip');
          if (chip) {
            chip.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;color:var(--accent)"><polyline points="20 6 9 17 4 12"/></svg> ' + tag + ' - Latest Release';
          }
          rel.assets.forEach(function(a) {
            var name = (a.name || '').toLowerCase();
            var url = a.browser_download_url;
            if (name.endsWith('.appimage')) { var el = document.getElementById('dl-appimage'); if (el) el.href = url; }
            else if (name.endsWith('.deb')) { var el = document.getElementById('dl-deb'); if (el) el.href = url; }
            else if (name.endsWith('.rpm')) { var el = document.getElementById('dl-rpm'); if (el) el.href = url; }
            else if (name.includes('.pkg.tar.zst')) { var el = document.getElementById('dl-arch'); if (el) el.href = url; }
            else if (name.endsWith('.exe')) { var el = document.getElementById('dl-exe'); if (el) el.href = url; }
            else if (name.endsWith('.msi')) { var el = document.getElementById('dl-msi'); if (el) el.href = url; }
            else if (name.endsWith('.dmg')) { var el = document.getElementById('dl-dmg'); if (el) el.href = url; }
          });
        })
        .catch(function() {});

      (function initMockupSwitcher() {
        var slides = [
          { title: 'Veluna · Home' },
          { title: 'Veluna · Synced Lyrics' }
        ];
        var currentIndex = 0;
        var trackEl = document.getElementById('mockup-track');
        var slideEls = document.querySelectorAll('.mockup-slide');
        if (!trackEl || !slideEls.length) return;
        var titleEl = document.getElementById('mockup-title');

        function showSlide(idx) {
          if (idx < 0) idx = slides.length - 1;
          if (idx >= slides.length) idx = 0;
          currentIndex = idx;
          trackEl.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
          for (var i = 0; i < slideEls.length; i++) {
            slideEls[i].classList.toggle('active', i === currentIndex);
          }
          if (titleEl && slides[currentIndex]) titleEl.textContent = slides[currentIndex].title;
        }

        var arrowPrev = document.getElementById('mockup-arrow-prev');
        var arrowNext = document.getElementById('mockup-arrow-next');
        if (arrowPrev) arrowPrev.addEventListener('click', function(e) { e.stopPropagation(); showSlide(currentIndex - 1); });
        if (arrowNext) arrowNext.addEventListener('click', function(e) { e.stopPropagation(); showSlide(currentIndex + 1); });

        var mockupWin = document.querySelector('.mockup-window');
        if (mockupWin) {
          mockupWin.setAttribute('tabindex', '0');
          mockupWin.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') showSlide(currentIndex - 1);
            else if (e.key === 'ArrowRight') showSlide(currentIndex + 1);
          });
          var touchStartX = 0;
          mockupWin.addEventListener('touchstart', function(e) {
            if (e.changedTouches && e.changedTouches[0]) touchStartX = e.changedTouches[0].clientX;
          }, { passive: true });
          mockupWin.addEventListener('touchend', function(e) {
            if (e.changedTouches && e.changedTouches[0]) {
              var diff = e.changedTouches[0].clientX - touchStartX;
              if (diff > 45) showSlide(currentIndex - 1);
              else if (diff < -45) showSlide(currentIndex + 1);
            }
          }, { passive: true });
        }
      })();
    })();
  </script>
</Base>
