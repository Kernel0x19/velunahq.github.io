---
---
<header class="hero">
  <div class="hero-bg-glows" aria-hidden="true">
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>
    <div class="glow-orb glow-orb-3"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title reveal d1">
      your<br><em>music</em><br><strong>deserves better.</strong>
    </h1>

    <p class="hero-desc reveal d2">
      Stream millions of songs with zero ads, download in high fidelity, and own your library. Built natively with Rust for pure speed and total privacy.
    </p>

    <div class="hero-ctas reveal d3">
      <a href="#download" class="btn-primary blob-btn">
        <span class="blob-btn__text">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Download for Free</span>
        </span>
        <span class="blob-btn__inner" aria-hidden="true">
          <span class="blob-btn__blobs">
            <span class="blob-btn__blob"></span>
            <span class="blob-btn__blob"></span>
            <span class="blob-btn__blob"></span>
            <span class="blob-btn__blob"></span>
          </span>
        </span>
      </a>
      <a href="https://github.com/velunahq/veluna" class="btn-secondary" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48v-1.7C6.73 19.91 6.14 18 6.14 18c-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85.004 1.71.115 2.51.337 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
        Star on GitHub
      </a>
    </div>

    <div class="hero-proof reveal d4">
      <div class="hero-proof-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span><strong>1,500+</strong> downloads</span>
      </div>
    </div>
  </div>

  <div class="hero-stage reveal d4">
    <div class="horizon-beam"></div>
    <div class="horizon-arc"></div>

    <div class="mockup-window">
      <div class="mockup-header">
        <div class="mockup-dots">
          <span class="mockup-dot red"></span>
          <span class="mockup-dot yellow"></span>
          <span class="mockup-dot green"></span>
        </div>
        <div class="mockup-title" id="mockup-title">Veluna</div>
      </div>
      <div class="mockup-viewport">
        <div class="mockup-track" id="mockup-track">
          <div class="mockup-slide active">
            <img src="/screenshots/ss1.png" alt="Veluna Desktop Music Player Interface - Home View" class="mockup-img" loading="eager" width="1909" height="988">
          </div>
          <div class="mockup-slide">
            <img src="/screenshots/ss2.png" alt="Veluna Desktop Music Player Interface - Synced Lyrics View" class="mockup-img" loading="lazy" width="1909" height="988">
          </div>
        </div>
        <button type="button" class="mockup-arrow prev" id="mockup-arrow-prev" aria-label="Previous screenshot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="mockup-arrow next" id="mockup-arrow-next" aria-label="Next screenshot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>
